{
  "name": "desktop-tidy",
  "version": "0.3.0",
  "private": true,
  "description": "本地优先的 Windows 桌面文件管理与检索工具",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:coverage": "c8 --check-coverage --lines 80 --functions 80 --branches 75 --reporter=text node --test test/*.test.cjs",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.desktoptidy",
    "productName": "桌面文件管家",
    "asar": true,
    "files": ["src/**/*", "package.json"],
    "win": { "icon": "assets/desktop-tidy-icon.ico", "target": ["nsis", "portable"] },
    "nsis": { "artifactName": "DesktopFileManager-Setup.${ext}", "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "deleteAppDataOnUninstall": false },
    "portable": { "artifactName": "DesktopFileManager-Portable.${ext}" }
  }
}
