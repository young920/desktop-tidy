{
  "name": "desktop-tidy",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的 Windows 桌面整理助手",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:coverage": "c8 --check-coverage --lines 80 --functions 80 --branches 75 --reporter=text node --test test/*.test.cjs",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.local.desktoptidy",
    "productName": "桌面清洁助手",
    "asar": true,
    "files": ["src/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
